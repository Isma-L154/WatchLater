# --- Database (Drizzle + libSQL/Turso) ---
# Production (Turso):
DATABASE_URL="libsql://db-name-user.turso.io"
DATABASE_AUTH_TOKEN=""
# Local development alternative (SQLite file, no cloud needed):
# DATABASE_URL="file:local.db"

# --- TMDB API ---
# TMDB v4 "API Read Access Token" (Bearer). Get it at:
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=""
